{
  "name": "art2fcl",
  "version": "1.0.0",
  "description": "ART2FCL / Azriel - Claude neon portfolio integration",
  "scripts": {
    "legacy:dev": "next dev",
    "legacy:build": "next build",
    "legacy:lint": "eslint . --max-warnings=0",
    "legacy:typecheck": "tsc --noEmit",
    "legacy:test": "playwright test",
    "legacy:preview": "node scripts/serve.mjs",
    "dev": "npm run build:preview && npm run preview",
    "build": "node scripts/build-portfolio.mjs",
    "build:preview": "node scripts/build-portfolio.mjs --local-audio",
    "preview": "node scripts/serve-portfolio.mjs",
    "check": "node scripts/check-portfolio.mjs",
    "lint": "eslint -c eslint.portfolio.config.mjs portfolio/assets/js scripts/build-portfolio.mjs scripts/serve-portfolio.mjs scripts/check-portfolio.mjs",
    "test": "playwright test -c playwright.portfolio.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.portfolio.json"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.67.0",
    "motion": "^14.9.0",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.4",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3"
  },
  "private": true
}
